# Copia este archivo a .env. Nunca subas el .env real.

# Supabase Postgres. DATABASE_URL usa asyncpg para la API y
# DATABASE_MIGRATION_URL usa psycopg para Alembic. Obtén ambas conexiones
# desde el diálogo "Connect" de Supabase y adapta el prefijo del driver.
DATABASE_URL="postgresql+asyncpg://prisma.PROJECT_REF:password@aws-REGION.pooler.supabase.com:5432/postgres"
DATABASE_MIGRATION_URL="postgresql+psycopg://prisma.PROJECT_REF:password@aws-REGION.pooler.supabase.com:5432/postgres"

# Supabase. La clave secreta pertenece exclusivamente a API/workers.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SECRET_KEY="sb_secret_xxx"
SUPABASE_STORAGE_BUCKET="raw-data"

# API y procesamiento asíncrono.
API_PORT=8000
REDIS_URL="redis://localhost:6379/0"
CORS_ORIGINS="http://localhost:3000"
