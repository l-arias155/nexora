# Copia este archivo a .env y completa los valores para tu entorno local.
# Nunca commitees el .env real: ya está en .gitignore.

# Cadena de conexión a PostgreSQL.
DATABASE_URL="postgresql://postgres:tu-password@localhost:5432/nexora?schema=public"

# Puerto donde escucha el backend.
PORT=3000

# Secretos para firmar los access tokens (JWT). Genera los tuyos, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="reemplaza-esto-con-un-secreto-aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"

# Vigencia del refresh token (días). El valor en sí es un string opaco, no un JWT.
JWT_REFRESH_EXPIRES_IN_DAYS="30"
